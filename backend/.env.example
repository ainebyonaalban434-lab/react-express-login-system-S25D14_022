# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string (see setup walkthrough)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/login-system?retryWrites=true&w=majority

# Any long random string, used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# Only needed in production — the exact URL of your deployed frontend
FRONTEND_URL=https://your-frontend.vercel.app
