# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/login-system?retryWrites=true&w=majority

# Any long random string, used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# The exact URL of your deployed frontend, no trailing slash.
# Several URLs can be separated with commas.
FRONTEND_URL=https://react-express-login-system-s25-d14.vercel.app

# Set this to production on Render
NODE_ENV=production
